rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    function cfgPath() { return /databases/$(database)/documents/config/main; }
    function hasCfg() { return exists(cfgPath()); }
    function isOpen() { return !hasCfg() || get(cfgPath()).data.state == 'registration'; }
    function isActive() { return hasCfg() && get(cfgPath()).data.state == 'active'; }
    function isFinal() { return isActive() && get(cfgPath()).data.finalDay == true; }
    function adminLocked() { return hasCfg() && get(cfgPath()).data.get('adminLocked', false) == true; }
    function votingOpen() { return hasCfg() && get(cfgPath()).data.get('voting', 'open') != 'closed'; }
    function isMember() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }

    function assignPath(uid) { return /databases/$(database)/documents/assignments/$(uid); }
    function iChose(uid) { return exists(assignPath(me())) && get(assignPath(me())).data.target == uid; }
    function choseMe(uid) { return exists(assignPath(uid)) && get(assignPath(uid)).data.target == me(); }

    function validProfile(d, uid) {
      return d.keys().hasOnly(['uid', 'email', 'studentCode', 'gender', 'lastName', 'firstName', 'phone', 'wishes', 'dislikes', 'createdAt', 'updatedAt', 'consentAt'])
        && d.keys().hasAll(['uid', 'email', 'studentCode', 'gender', 'lastName', 'firstName', 'phone', 'wishes'])
        && d.uid == uid
        && d.email == request.auth.token.email
        && d.studentCode is string && d.studentCode.matches('^B[0-9]{9}$')
        && d.gender in ['male', 'female']
        && d.lastName is string && d.lastName.size() > 0 && d.lastName.size() <= 60
        && d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 60
        && d.phone is string && d.phone.matches('^[0-9]{8}$')
        && d.wishes is string && d.wishes.size() <= 1000
        && (!('dislikes' in d) || (d.dislikes is string && d.dislikes.size() <= 500));
    }

    // Тохиргоо: төлөв, өдрүүд, сэдэв
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Админ: зөвхөн тусгай кодоор
    match /admins/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && me() == uid && !adminLocked()
        && request.resource.data.keys().hasOnly(['code', 'email', 'createdAt'])
        && request.resource.data.code is string
        && hashing.sha256(request.resource.data.code).toHexString().lower() == 'f68808f1d8413410883bf62d3df048385676aaeca1aff3162a4f0736b38e0893';
      allow delete: if isAdmin();
    }

    // Оролцогчийн мэдээлэл
    match /users/{uid} {
      allow get: if signedIn() && (
        me() == uid
        || isAdmin()
        || (isActive() && iChose(uid))
        || (isFinal() && choseMe(uid))
      );
      allow list: if isAdmin();
      allow create: if signedIn() && me() == uid && isOpen()
        && validProfile(request.resource.data, uid)
        && getAfter(/databases/$(database)/documents/studentCodes/$(request.resource.data.studentCode)).data.uid == uid;
      allow update: if signedIn() && me() == uid && isOpen()
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && getAfter(/databases/$(database)/documents/studentCodes/$(request.resource.data.studentCode)).data.uid == uid
        && (request.resource.data.studentCode == resource.data.studentCode
            || !existsAfter(/databases/$(database)/documents/studentCodes/$(resource.data.studentCode)));
      // Админ, эсвэл монита эхлэхээс өмнө оролцогч өөрөө
      allow delete: if isAdmin() || (signedIn() && me() == uid && isOpen());
      // Админ нөөцөөс сэргээх
      allow create, update: if isAdmin();
    }

    // Профайл зураг (мэдээлэлтэй адил хүмүүст харагдана)
    match /photos/{uid} {
      allow get: if signedIn() && (
        me() == uid
        || isAdmin()
        || (isActive() && iChose(uid))
        || (isFinal() && choseMe(uid))
      );
      allow create, update: if signedIn() && me() == uid && isOpen()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 250000;
      allow delete: if isAdmin() || (signedIn() && me() == uid && isOpen());
    }

    // Админы жагсаалтад харагдах жижиг зураг
    match /thumbs/{uid} {
      allow get, list: if isAdmin();
      allow create, update: if signedIn() && me() == uid && isOpen()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 30000;
      allow delete: if isAdmin() || (signedIn() && me() == uid && isOpen());
    }

    // Оюутны код давхцахгүй
    match /studentCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && isOpen()
        && code.matches('^B[0-9]{9}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentCode == code;
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && isOpen() && resource.data.uid == me()
            && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentCode != code));
    }

    // Хэн хэнийг сонгосон
    match /assignments/{giver} {
      allow get: if isAdmin() || (signedIn() && me() == giver && isActive());
      allow list: if isAdmin() || (signedIn() && isFinal() && resource.data.target == me());
      allow write: if isAdmin();
    }

    // Нэргүй захидал. t = бэлэг авагч; 'down' = t-г сонгосон хүнээс, 'up' = t-ээс өөрийг нь сонгосон хүн рүү.
    // Илгээгчийн нэр хадгалагдахгүй; k нь тухайн холболтын түлхүүр.
    match /letters/{id} {
      allow read: if isAdmin() || (signedIn() && isActive()
        && (resource.data.t == me() || iChose(resource.data.t)));
      allow create: if signedIn() && isActive()
        && request.resource.data.keys().hasOnly(['t', 'dir', 'k', 'text', 'createdAt'])
        && request.resource.data.t is string
        && request.resource.data.k is string && request.resource.data.k.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.dir == 'up' && request.resource.data.t == me())
            || (request.resource.data.dir == 'down' && iChose(request.resource.data.t)
                && request.resource.data.k == get(assignPath(me())).data.k));
      allow create, update, delete: if isAdmin();
    }

    // Сүүлийн өдрийн бэлгийн зураг (хүн бүр нэг)
    match /gifts/{uid} {
      allow read: if isAdmin() || (signedIn() && isFinal() && isMember());
      allow create, update: if signedIn() && me() == uid && isFinal() && votingOpen() && isMember()
        && request.resource.data.keys().hasOnly(['data', 'ratio', 'caption', 'createdAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 250000
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 120
        && request.resource.data.ratio is number;
      allow delete: if isAdmin() || (signedIn() && me() == uid);
    }

    // Шилдэг бэлгийн санал: хүн бүр нэг санал, хэн хэнд өгснийг зөвхөн админ харна
    match /votes/{uid} {
      allow get: if isAdmin() || (signedIn() && me() == uid);
      allow list: if isAdmin();
      allow create, update: if signedIn() && me() == uid && isFinal() && votingOpen() && isMember()
        && request.resource.data.keys().hasOnly(['entry', 'createdAt'])
        && request.resource.data.entry is string && request.resource.data.entry != uid
        && exists(/databases/$(database)/documents/gifts/$(request.resource.data.entry));
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && me() == uid && votingOpen());
    }

    // Алдааны бүртгэл: хэрэглэгч бүр хамгийн ихдээ 50 бичлэг, зөвхөн админ уншина
    match /errors/{id} {
      allow create, update: if signedIn() && id.matches('^' + me() + '_e[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['uid', 'where', 'msg', 'code', 'page', 'ua', 'v', 'at'])
        && request.resource.data.uid == me()
        && request.resource.data.where is string && request.resource.data.where.size() <= 60
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.code is string && request.resource.data.code.size() <= 60
        && request.resource.data.page is string && request.resource.data.page.size() <= 40
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.v is string && request.resource.data.v.size() <= 10;
      allow read, delete: if isAdmin();
    }

    // Мэдэгдэл, захидлыг уншсан төлөв (төхөөрөмж хооронд)
    match /reads/{uid} {
      allow get: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['notif', 'letters'])
        && (!('notif' in request.resource.data) || request.resource.data.notif is number)
        && (!('letters' in request.resource.data) || request.resource.data.letters is number);
      allow delete: if isAdmin() || (signedIn() && me() == uid);
    }

    // Мэдэгдэл
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.to == me() || resource.data.to == 'all'));
      allow create, delete: if isAdmin();
    }

    // Нүүр хуудасны зар
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcementFiles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
